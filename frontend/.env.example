# Copy to web/frontend/.env.local

# Project Settings -> API. Both of these end up inside the built JavaScript and
# are meant to: the anon key identifies the project, it does not authorise
# anything. What stops one account reading another's rows is row level security
# in the database, not the secrecy of this string.
#
# The service_role key is the opposite -- it bypasses RLS entirely. It belongs
# on a server or nowhere. If it ever appears in this file, rotate it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the Flask API in web/api is listening.
VITE_API_URL=http://127.0.0.1:5002
