# Copy to web/api/.env and fill in. .env is gitignored; never commit the real one.

# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> Database -> Connection string (session pooler).
# This role can write public.questions, so it is the server's credential and
# never the browser's.
DATABASE_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Only for projects still on the legacy HS256 JWT secret. Projects using
# asymmetric signing keys verify through JWKS and can leave this blank.
SUPABASE_JWT_SECRET=

# Where the frontend is served from, comma separated.
CORS_ORIGINS=http://localhost:5173

# Encrypts the per-user Gemini keys in `user_secrets`. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# There is deliberately no server-wide Gemini key: each player brings their
# own, stored encrypted per account. This is the key that opens that column,
# and it must never be stored in Postgres alongside what it decrypts.
# Rotating it makes every saved key unreadable and players re-enter theirs.
SECRETS_ENCRYPTION_KEY=
